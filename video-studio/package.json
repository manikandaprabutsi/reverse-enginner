{
  "name": "resolve-lite-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based multi-track video editor inspired by professional NLE workflows",
  "scripts": {
    "predev": "node scripts/copy-ffmpeg.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^3.2.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
